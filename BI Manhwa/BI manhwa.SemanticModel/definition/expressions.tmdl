expression Fonte =
		let
		    // =====================================================================
		    // FONTE - Planilha de controle de leitura (Excel local)
		    // Base única usada por Fato_Leitura, Dim_Genero e Dim_Status
		    // O caminho do arquivo fica no parâmetro CaminhoBase
		    // =====================================================================
		    Fonte = Excel.Workbook(File.Contents(CaminhoBase), null, true),
		    Página1_Sheet = Fonte{[Item="Página1",Kind="Sheet"]}[Data],
		    #"Cabeçalhos Promovidos" = Table.PromoteHeaders(Página1_Sheet, [PromoteAllScalars=true]),
		
		    // Mantém só as 8 colunas da base (ignora colunas vazias que o Excel possa trazer)
		    #"Outras Colunas Removidas" = Table.SelectColumns(#"Cabeçalhos Promovidos",{"Origem", "Manhwas/Mangás", "Capitulo", "Gênero 1", "Gênero 2", "Status", "Nota", "Data"}),
		    #"Colunas Renomeadas" = Table.RenameColumns(#"Outras Colunas Removidas",{{"Manhwas/Mangás", "Nome"}}),
		
		    // Colunas de texto que recebem limpeza
		    ColunasTexto = {"Origem", "Nome", "Gênero 1", "Gênero 2", "Status"},
		
		    // Remove espaços sobrando no início/fim (evita "Sistema " virar outro gênero)
		    #"Texto Limpo" = Table.TransformColumns(
		        #"Colunas Renomeadas",
		        List.Transform(ColunasTexto, (col) => {col, each if _ is text then Text.Trim(_) else _})
		    ),
		
		    // Célula vazia ("") vira null (evita gênero/status em branco nas dimensões)
		    #"Vazios para Nulo" = Table.ReplaceValue(#"Texto Limpo", "", null, Replacer.ReplaceValue, ColunasTexto),
		
		    #"Tipo Alterado" = Table.TransformColumnTypes(
		        #"Vazios para Nulo",
		        {
		            {"Origem", type text}, {"Nome", type text}, {"Capitulo", Int64.Type},
		            {"Gênero 1", type text}, {"Gênero 2", type text}, {"Status", type text},
		            {"Nota", Int64.Type}, {"Data", type date}
		        }
		    ),
		
		    // Descarta linhas sem nome (linhas em branco no fim da planilha)
		    #"Linhas sem Nome Removidas" = Table.SelectRows(#"Tipo Alterado", each [Nome] <> null)
		in
		    #"Linhas sem Nome Removidas"
	lineageTag: 4444d539-ca0e-4f8d-9d3e-3d5a34f3dfdd

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

expression 'Dim_Genero aux' =
		let
		    Fonte = Fonte,
		    #"Outras Colunas Removidas" = Table.SelectColumns(Fonte,{"Gênero 1", "Gênero 2"}),
		    #"Colunas Removidas" = Table.RemoveColumns(#"Outras Colunas Removidas",{"Gênero 1"}),
		    #"Colunas Renomeadas" = Table.RenameColumns(#"Colunas Removidas",{{"Gênero 2", "Gênero"}})
		in
		    #"Colunas Renomeadas"
	lineageTag: fc0d3849-f737-4369-9616-aa92d6261ddd

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

/// Caminho completo do Excel com a base de leitura (Mangas_manhwas.xlsx). Quem baixar o projeto troca só este valor.
expression CaminhoBase = "C:\Bases port\Mangas_manhwas.xlsx" meta [IsParameterQuery=true, Type="Text", IsParameterQueryRequired=true]
	lineageTag: 6b0f2c1e-8d4a-4f7b-9c31-2a5e7d9b4f10

	annotation PBI_ResultType = Text

