model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

annotation PBI_QueryOrder = ["fPrecos","dLocal","dProduto","DataInicial","fxBaixarArquivo","Base ANP","Links ANP"]

ref table fPrecos
ref table dLocal
ref table dProduto
ref table dCalendario
ref table _Medidas

ref cultureInfo pt-BR

