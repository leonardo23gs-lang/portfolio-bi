	/// Lucro Bruto menos despesas operacionais (equivalente ao EBITDA da operação).
	measure 'Resultado Operacional' = [Lucro Bruto] + [Gastos Variáveis com Vendas] + [Gastos Fixos]
		formatString: R$ #,##0.00
		displayFolder: 07 Resultado Operacional
		lineageTag: 87443660-36b4-4f8e-9d92-39f807cef819

	/// Resultado Operacional combinando valores reais e projeções.
