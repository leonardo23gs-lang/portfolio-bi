table _Medidas
	lineageTag: 6f92cce9-8205-4153-b078-eeff771b7dfe

	/// Fator aplicado sobre o mesmo mês do ano anterior quando não há valor real lançado na DRE (padrão: +5%).
	measure 'Fator Previsão' = 1.05
		formatString: 0%
		displayFolder: 00 Parâmetros
		lineageTag: aa0a7136-d6af-45e9-8607-dec3aa1833cf

	/// Soma da Receita Bruta de Vendas (NIVEL1 da DRE).
	measure 'Receita Bruta de Vendas' =
			// Soma os lançamentos da fDRE do grupo "RECEITA BRUTA DE VENDAS"
			// (valor com sinal: receitas +, custos/despesas -)
			CALCULATE(
			    SUM(fDRE[VALOR]),
			    fDRE[NIVEL1] = "RECEITA BRUTA DE VENDAS"
			)
		formatString: R$ #,##0.00
		displayFolder: 01 Receita Bruta
		lineageTag: 963e9370-d182-4602-b2fa-51ff75ae9bb4

	/// Receita Bruta de Vendas no mesmo período do ano anterior.
	measure 'Receita Bruta de Vendas LY' = CALCULATE([Receita Bruta de Vendas], SAMEPERIODLASTYEAR(dCalendario[Date]))
		formatString: R$ #,##0.00
		displayFolder: 01 Receita Bruta
		lineageTag: eb28271a-93bf-4686-88d0-65ecbcfb0142

	/// Usa o valor real quando existe; se o mês ainda não tem lançamento, projeta com base no mesmo mês do ano anterior x Fator Previsão.
	measure 'Receita Bruta de Vendas (Real + Previsão)' =
			SUMX(
			    SUMMARIZE(dCalendario, dCalendario[Ano], dCalendario[NumMes]),
			    VAR _IsFuture = dCalendario[Ano] > YEAR(TODAY()) || (dCalendario[Ano] = YEAR(TODAY()) && dCalendario[NumMes] > MONTH(TODAY()))
			    VAR _Real = IF(_IsFuture, BLANK(), [Receita Bruta de Vendas])
			    VAR _LY = [Receita Bruta de Vendas LY]
			    RETURN IF(ISBLANK(_Real), _LY * [Fator Previsão], _Real)
			)
		formatString: R$ #,##0.00
		displayFolder: 01 Receita Bruta
		lineageTag: 0e233e37-d662-4a45-ae3a-0722cb164f97

	/// Variação percentual da Receita Bruta vs ano anterior.
	measure 'Receita Bruta de Vendas Var%' = DIVIDE([Receita Bruta de Vendas] - [Receita Bruta de Vendas LY], [Receita Bruta de Vendas LY])
		formatString: 0.0%
		displayFolder: 01 Receita Bruta
		lineageTag: fbf62dea-e09d-490f-8291-417f26781609

	/// Impostos sobre faturamento e demais deduções (valor negativo).
	measure 'Deduções da Receita Bruta' =
			// Soma os lançamentos da fDRE do grupo "DEDUÇÕES DA RECEITA BRUTA"
			// (valor com sinal: receitas +, custos/despesas -)
			CALCULATE(
			    SUM(fDRE[VALOR]),
			    fDRE[NIVEL1] = "DEDUÇÕES DA RECEITA BRUTA"
			)
		formatString: R$ #,##0.00
		displayFolder: 02 Deduções da Receita Bruta
		lineageTag: 341ab35a-6720-4930-8ece-124ea4be1bb0

	/// Deduções da Receita Bruta no mesmo período do ano anterior.
	measure 'Deduções da Receita Bruta LY' = CALCULATE([Deduções da Receita Bruta], SAMEPERIODLASTYEAR(dCalendario[Date]))
		formatString: R$ #,##0.00
		displayFolder: 02 Deduções da Receita Bruta
		lineageTag: e0cf36d0-2347-41bf-b4e9-b378730026dc

	/// Real quando existe; projeção LY x Fator Previsão quando não há lançamento.
	measure 'Deduções da Receita Bruta (Real + Previsão)' =
			SUMX(
			    SUMMARIZE(dCalendario, dCalendario[Ano], dCalendario[NumMes]),
			    VAR _IsFuture = dCalendario[Ano] > YEAR(TODAY()) || (dCalendario[Ano] = YEAR(TODAY()) && dCalendario[NumMes] > MONTH(TODAY()))
			    VAR _Real = IF(_IsFuture, BLANK(), [Deduções da Receita Bruta])
			    VAR _LY = [Deduções da Receita Bruta LY]
			    RETURN IF(ISBLANK(_Real), _LY * [Fator Previsão], _Real)
			)
		formatString: R$ #,##0.00
		displayFolder: 02 Deduções da Receita Bruta
		lineageTag: b474a965-7509-4ac1-ac17-7cd624e713dd

	/// Receita Bruta de Vendas menos Deduções da Receita Bruta.
	measure 'Receita Líquida' = [Receita Bruta de Vendas] + [Deduções da Receita Bruta]
		formatString: R$ #,##0.00
		displayFolder: 03 Receita Líquida
		lineageTag: 509b12f1-38e6-4d91-b2c7-414aa231038b

	/// Receita Líquida no mesmo período do ano anterior.
	measure 'Receita Líquida LY' = CALCULATE([Receita Líquida], SAMEPERIODLASTYEAR(dCalendario[Date]))
		formatString: R$ #,##0.00
		displayFolder: 03 Receita Líquida
		lineageTag: 9ddbff0a-7726-499b-bcd2-7d6e74d72d24

	/// Receita Líquida combinando valores reais e projeções.
	measure 'Receita Líquida (Real + Previsão)' = [Receita Bruta de Vendas (Real + Previsão)] + [Deduções da Receita Bruta (Real + Previsão)]
		formatString: R$ #,##0.00
		displayFolder: 03 Receita Líquida
		lineageTag: 411bc4fd-f87d-4e93-84a9-209ba5609c17

	/// Custo das Mercadorias Vendidas (CMV), valor negativo.
	measure 'Custo das Mercadorias Vendidas' =
			// Soma os lançamentos da fDRE do grupo "CUSTO DAS MERCADORIAS VENDIDAS"
			// (valor com sinal: receitas +, custos/despesas -)
			CALCULATE(
			    SUM(fDRE[VALOR]),
			    fDRE[NIVEL1] = "CUSTO DAS MERCADORIAS VENDIDAS"
			)
		formatString: R$ #,##0.00
		displayFolder: 04 CMV
		lineageTag: 1488432e-c255-4455-9476-a24414efa084

	/// CMV no mesmo período do ano anterior.
	measure 'CMV LY' = CALCULATE([Custo das Mercadorias Vendidas], SAMEPERIODLASTYEAR(dCalendario[Date]))
		formatString: R$ #,##0.00
		displayFolder: 04 CMV
		lineageTag: ddb1de2c-e697-466e-9853-d042d5a5c01d

	/// CMV real quando existe; projeção LY x Fator Previsão quando não há lançamento.
	measure 'CMV (Real + Previsão)' =
			SUMX(
			    SUMMARIZE(dCalendario, dCalendario[Ano], dCalendario[NumMes]),
			    VAR _IsFuture = dCalendario[Ano] > YEAR(TODAY()) || (dCalendario[Ano] = YEAR(TODAY()) && dCalendario[NumMes] > MONTH(TODAY()))
			    VAR _Real = IF(_IsFuture, BLANK(), [Custo das Mercadorias Vendidas])
			    VAR _LY = [CMV LY]
			    RETURN IF(ISBLANK(_Real), _LY * [Fator Previsão], _Real)
			)
		formatString: R$ #,##0.00
		displayFolder: 04 CMV
		lineageTag: 6114dd91-b30a-4175-95e8-542d5355644e

	/// Receita Líquida menos CMV.
	measure 'Lucro Bruto' = [Receita Líquida] + [Custo das Mercadorias Vendidas]
		formatString: R$ #,##0.00
		displayFolder: 05 Lucro Bruto
		lineageTag: 43ab3d49-dd96-47ea-8786-fcdcf07b10c7

	/// Lucro Bruto combinando valores reais e projeções.
	measure 'Lucro Bruto (Real + Previsão)' = [Receita Líquida (Real + Previsão)] + [CMV (Real + Previsão)]
		formatString: R$ #,##0.00
		displayFolder: 05 Lucro Bruto
		lineageTag: 1c315c44-383d-4934-a29a-c617e3b3be20

	/// Lucro Bruto / Receita Líquida.
	measure 'Margem Bruta %' = DIVIDE([Lucro Bruto (Real + Previsão)], [Receita Líquida (Real + Previsão)])
		formatString: 0.0%
		displayFolder: 05 Lucro Bruto
		lineageTag: 2bec4d5b-0213-4ab6-94b2-757400bfe533

