	/// Ano exibido no relatório HTML da DRE. Usa o ano da segmentação 'Parâmetro Ano DRE'[Ano]; sem seleção, usa o último ano com dados na fDRE.
	measure 'Ano Referência DRE' =
			// Ano exibido no relatório HTML.
			// 1) Se houver ano selecionado na segmentação 'Parâmetro Ano DRE', usa ele.
			// 2) Senão, usa o último ano que tem lançamento na fDRE.
			VAR AnoSelecionado = SELECTEDVALUE('Parâmetro Ano DRE'[Ano])
			VAR UltimoAnoBase  = YEAR(CALCULATE(MAX(fDRE[DATA]), REMOVEFILTERS()))
			RETURN
			    COALESCE(AnoSelecionado, UltimoAnoBase)
		formatString: 0
		displayFolder: 00 Parâmetros
		lineageTag: 772de25f-2f22-49ad-a221-f4ae7c4cbf5f

	/// Bloco <style> reaproveitado por todos os visuais HTML da DRE. Edite aqui para mudar cores/layout em todos de uma vez.
	measure 'HTML CSS Base' =
			// =====================================================================
			// HTML CSS Base
			// Bloco <style> usado por todo o relatório HTML da DRE.
			// Edite aqui para mudar cores, fontes e layout de uma vez só.
			// Cada linha abaixo = 1 regra CSS. Agrupado por parte do relatório.
			// Paleta (tema escuro): fundo #0b1220 | painel #111a2e | borda #243252
			//   texto #e8ecf7 | texto suave #8a94b3 | azul #60a5fa | verde #34d399
			//   amarelo #fbbf24 | vermelho #f87171 | dourado (previsto) #c9974a
			// =====================================================================
			"<style>"
			
			    // ---- 1. Container principal (fundo escuro, borda, faixa colorida no topo)
			    & ".dre-report{position:relative;overflow:hidden;font-family:'Segoe UI',Arial,sans-serif;background:#0b1220;color:#e8ecf7;padding:24px 28px 20px;border-radius:10px;box-shadow:0 8px 30px rgba(0,0,0,.35);}"
			    & ".dre-report::before{content:'';position:absolute;top:0;left:0;right:0;height:4px;background:linear-gradient(90deg,#60a5fa,#34d399,#fbbf24,#f87171);}"
			
			    // ---- 2. Cabeçalho: título, subtítulo, data de atualização e legenda (chips)
			    & ".dre-report .head{display:flex;justify-content:space-between;align-items:flex-end;border-bottom:1px solid #243252;padding-bottom:12px;margin-bottom:14px;}"
			    & ".dre-report .brand{display:flex;align-items:center;gap:10px;}"
			    & ".dre-report .title{font-size:22px;font-weight:700;}"
			    & ".dre-report .title b{background:linear-gradient(90deg,#60a5fa,#34d399);-webkit-background-clip:text;background-clip:text;color:transparent;}"
			    & ".dre-report .sub{color:#8a94b3;font-size:12px;margin-top:2px;}"
			    & ".dre-report .meta{text-align:right;color:#8a94b3;font-size:11.5px;line-height:1.5;}"
			    & ".dre-report .legend{margin-top:6px;}"
			    & ".dre-report .chip{display:inline-block;padding:2px 9px;border-radius:20px;font-size:10.5px;font-weight:600;margin-left:6px;border:1px solid transparent;}"
			    & ".dre-report .chip.attention{background:rgba(52,211,153,.15);color:#34d399;border-color:rgba(52,211,153,.35);}"
			    & ".dre-report .chip.alert{background:rgba(251,191,36,.15);color:#fbbf24;border-color:rgba(251,191,36,.35);}"
			    & ".dre-report .chip.management{background:rgba(248,113,113,.15);color:#f87171;border-color:rgba(248,113,113,.35);}"
			
			    // ---- 3. Cards de KPI (frente/verso com efeito flip no hover) e barra de progresso
			    & ".dre-report .grid{display:grid;gap:12px;margin-bottom:14px;}"
			    & ".dre-report .grid.g4{grid-template-columns:repeat(4,1fr);}"
			    & ".dre-report .card{position:relative;height:142px;perspective:1200px;}"
			    & ".dre-report .card-inner{position:relative;width:100%;height:100%;transition:transform .5s cubic-bezier(.4,.2,.2,1);transform-style:preserve-3d;}"
			    & ".dre-report .card:hover .card-inner{transform:rotateY(180deg);}"
			    & ".dre-report .card-face{position:absolute;inset:0;backface-visibility:hidden;-webkit-backface-visibility:hidden;background:linear-gradient(180deg,#111a2e,#0f1830);border:1px solid #243252;border-radius:10px;padding:12px 16px;box-shadow:0 2px 10px rgba(0,0,0,.25);box-sizing:border-box;overflow:hidden;}"
			    & ".dre-report .card-back{transform:rotateY(180deg);display:flex;flex-direction:column;justify-content:center;}"
			    & ".dre-report .card-back h4{font-size:9px;color:#8a94b3;text-transform:uppercase;letter-spacing:.4px;margin-bottom:4px;font-weight:600;}"
			    & ".dre-report .card-back .bline{display:flex;justify-content:space-between;font-size:10px;color:#8a94b3;padding:1.5px 0;border-bottom:1px dashed #243252;line-height:1.35;}"
			    & ".dre-report .card-back .bline span{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;margin-right:6px;}"
			    & ".dre-report .card-back .bline b{white-space:nowrap;flex-shrink:0;color:#e8ecf7;font-weight:700;}"
			    & ".dre-report .card-back .bline.result{border-bottom:none;margin-top:2px;font-size:11px;}"
			    & ".dre-report .card-back .bline.result span,.dre-report .card-back .bline.result b{color:#34d399;}"
			    & ".dre-report .card h3{font-size:11.5px;color:#8a94b3;text-transform:uppercase;letter-spacing:.4px;font-weight:600;margin-bottom:6px;}"
			    & ".dre-report .card .value{font-size:22px;font-weight:700;}"
			    & ".dre-report .card .compare{display:flex;justify-content:space-between;font-size:11.5px;color:#8a94b3;margin-top:8px;}"
			    & ".dre-report .card .compare b{color:#e8ecf7;}"
			    & ".dre-report .track{background:#1b2540;border-radius:6px;height:6px;margin-top:8px;overflow:hidden;}"
			    & ".dre-report .fill{height:100%;border-radius:6px;}"
			    & ".dre-report .fill.attention{background:#34d399;}"
			    & ".dre-report .fill.alert{background:#fbbf24;}"
			    & ".dre-report .fill.management{background:#f87171;}"
			
			    // ---- 4. Barra de ferramentas: seletor de mês e botão de tema
			    & ".dre-report .toolbar{display:flex;justify-content:flex-end;align-items:center;gap:8px;margin-bottom:10px;}"
			    & ".dre-report .theme-btn{background:#1b2540;color:#e8ecf7;border:1px solid #243252;border-radius:20px;padding:5px 14px;font-size:11px;font-weight:600;cursor:pointer;}"
			    & ".dre-report .theme-btn:hover{background:#243252;}"
			
			    // ---- 5. Painel da tabela: título, rolagem horizontal e cabeçalho (meses)
			    & ".dre-report .panel{background:#111a2e;border:1px solid #243252;border-radius:10px;padding:14px 18px;box-shadow:0 2px 10px rgba(0,0,0,.2);}"
			    & ".dre-report .panel-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;padding-bottom:8px;border-bottom:1px solid #243252;}"
			    & ".dre-report .panel-title h2{font-size:14px;font-weight:600;}"
			    & ".dre-report .panel-title .hint{font-size:10.5px;color:#8a94b3;}"
			    & ".dre-report .table-scroll{overflow-x:auto;overflow-y:hidden;border-radius:6px;}"
			    & ".dre-report .table-scroll::-webkit-scrollbar{height:8px;}"
			    & ".dre-report .table-scroll::-webkit-scrollbar-thumb{background:#243252;border-radius:6px;}"
			    & ".dre-report .table-scroll::-webkit-scrollbar-track{background:transparent;}"
			    & ".dre-report table{width:100%;min-width:1500px;border-collapse:collapse;font-size:11px;}"
			    & ".dre-report thead th{background:#0b1220;text-align:right;color:#8a94b3;font-weight:600;font-size:10px;text-transform:uppercase;padding:4px 8px 6px;border-bottom:1px solid #243252;vertical-align:bottom;white-space:nowrap;}"
			    & ".dre-report thead th:first-child{text-align:left;position:sticky;left:0;z-index:3;}"
			    & ".dre-report thead th.total-h{color:#60a5fa;}"
			    & ".dre-report thead th .monthsub{display:flex;justify-content:flex-end;gap:8px;font-size:8px;font-weight:500;text-transform:none;margin-top:3px;}"
			    & ".dre-report thead th .monthsub .sp{color:#c9974a;}"
			    & ".dre-report thead th .monthsub .sr{color:#8a94b3;}"
			
			    // ---- 6. Corpo da tabela: linhas da DRE (início, subtotal, total) e células Prev/Real
			    & ".dre-report tbody td{padding:6px 8px;text-align:right;border-bottom:1px solid rgba(255,255,255,.04);white-space:nowrap;vertical-align:middle;}"
			    & ".dre-report tbody td.cat{text-align:left;color:#c3cae0;white-space:normal;min-width:190px;max-width:220px;position:sticky;left:0;z-index:1;background:#0b1220;box-shadow:2px 0 6px rgba(0,0,0,.3);}"
			    & ".dre-report tr.row-start td{background:rgba(251,191,36,.07);font-weight:700;border-top:2px solid rgba(251,191,36,.5);border-bottom:2px solid rgba(251,191,36,.25);}"
			    & ".dre-report tr.row-start td.cat{color:#fbbf24;background:#2a2210;}"
			    & ".dre-report tr.row-subtotal td{background:rgba(96,165,250,.06);font-weight:700;border-top:2px solid rgba(96,165,250,.4);}"
			    & ".dre-report tr.row-subtotal td.cat{color:#60a5fa;background:#122036;border-left:3px solid transparent;}"
			    & ".dre-report tr.row-total td{background:rgba(52,211,153,.10);font-weight:800;font-size:12.5px;border-top:2px solid rgba(52,211,153,.5);}"
			    & ".dre-report tr.row-total td.cat{color:#34d399;background:#0f2a22;border-left:3px solid transparent;}"
			    & ".dre-report td.total{color:#e8ecf7;font-weight:700;border-left:1px solid #243252;}"
			    & ".dre-report td.total.prevtotal{color:#c9974a;font-weight:600;}"
			    & ".dre-report td.total.deltatotal{font-weight:700;font-size:10.5px;}"
			    & ".dre-report td.mc{white-space:nowrap;}"
			    & ".dre-report td.mc .prev{display:inline-block;color:#8a94b3;font-size:10px;min-width:26px;text-align:right;margin-right:6px;vertical-align:baseline;}"
			    & ".dre-report td.mc .real{display:inline-flex;align-items:baseline;gap:3px;color:#e8ecf7;font-weight:700;font-size:11px;text-align:right;white-space:nowrap;vertical-align:baseline;}"
			    & ".dre-report td.mc .delta{font-size:8.5px;font-weight:700;display:inline-flex;align-items:center;gap:1px;}"
			    & ".dre-report td.mc .delta.up{color:#34d399;}"
			    & ".dre-report td.mc .delta.down{color:#f87171;}"
			    & ".dre-report td.deltatotal.up{color:#34d399;}"
			    & ".dre-report td.deltatotal.down{color:#f87171;}"
			
			    // ---- 7. Tema claro (classe .light no container, ligada pelo botão ☀️/🌙)
			    & ".dre-report.light{background:#dde3ee;color:#182238;box-shadow:0 8px 24px rgba(20,30,60,.15);}"
			    & ".dre-report.light .head{border-color:#c3cbdd;}"
			    & ".dre-report.light .sub,.dre-report.light .meta{color:#4b5573;}"
			    & ".dre-report.light .title b{background:linear-gradient(90deg,#2563eb,#059669);-webkit-background-clip:text;background-clip:text;color:transparent;}"
			    & ".dre-report.light .card{background:linear-gradient(180deg,#f4f6fb,#e7ebf4);border-color:#c3cbdd;box-shadow:0 2px 8px rgba(20,30,60,.1);}"
			    & ".dre-report.light .card h3{color:#4b5573;}"
			    & ".dre-report.light .card .compare{color:#4b5573;}"
			    & ".dre-report.light .card .compare b{color:#182238;}"
			    & ".dre-report.light .track{background:#c9d1e3;}"
			    & ".dre-report.light .panel{background:#e9edf5;border-color:#c3cbdd;box-shadow:0 2px 10px rgba(20,30,60,.08);}"
			    & ".dre-report.light .panel-title{border-color:#c3cbdd;}"
			    & ".dre-report.light .panel-title .hint{color:#4b5573;}"
			    & ".dre-report.light .theme-btn{background:#f4f6fb;border-color:#c3cbdd;color:#182238;}"
			    & ".dre-report.light .theme-btn:hover{background:#e2e7f2;}"
			    & ".dre-report.light .table-scroll::-webkit-scrollbar-thumb{background:#c3cbdd;}"
			    & ".dre-report.light thead th{background:#dde3ee;color:#4b5573;border-color:#c3cbdd;}"
			    & ".dre-report.light thead th .monthsub .sp{color:#a9700f;}"
			    & ".dre-report.light thead th .monthsub .sr{color:#4b5573;}"
			    & ".dre-report.light tbody td{border-color:rgba(20,30,60,.1);}"
			    & ".dre-report.light tbody td.cat{color:#182238;background:#e9edf5;box-shadow:2px 0 6px rgba(20,30,60,.12);}"
			    & ".dre-report.light tr.row-start td{background:rgba(180,130,20,.10);border-top:2px solid rgba(180,130,20,.45);border-bottom:2px solid rgba(180,130,20,.2);}"
			    & ".dre-report.light tr.row-start td.cat{color:#a9700f;background:#f7ecd9;}"
			    & ".dre-report.light tr.row-subtotal td{background:rgba(37,99,235,.10);border-top:2px solid rgba(37,99,235,.4);}"
			    & ".dre-report.light tr.row-subtotal td.cat{color:#2563eb;background:#dbe4f7;}"
			    & ".dre-report.light tr.row-total td{background:rgba(5,150,105,.14);border-top:2px solid rgba(5,150,105,.5);}"
			    & ".dre-report.light tr.row-total td.cat{color:#059669;background:#d7f0e6;}"
			    & ".dre-report.light td.total{color:#182238;border-color:#c3cbdd;}"
			    & ".dre-report.light td.total.prevtotal{color:#a9700f;}"
			    & ".dre-report.light td.mc .prev{color:#a9700f;}"
			    & ".dre-report.light td.mc .real{color:#182238;}"
			    & ".dre-report.light td.mc .delta.up{color:#059669;}"
			    & ".dre-report.light td.mc .delta.down{color:#dc2626;}"
			    & ".dre-report.light td.deltatotal.up{color:#059669;}"
			    & ".dre-report.light td.deltatotal.down{color:#dc2626;}"
			    & ".dre-report.light .card-face{background:linear-gradient(180deg,#f4f6fb,#e7ebf4);border-color:#c3cbdd;box-shadow:0 2px 8px rgba(20,30,60,.1);}"
			    & ".dre-report.light .card-back .bline{color:#4b5573;border-color:#c3cbdd;}"
			    & ".dre-report.light .card-back .bline b{color:#182238;}"
			    & ".dre-report.light .card-back .bline.result span,.dre-report.light .card-back .bline.result b{color:#059669;}"
			    & ".dre-report.light .card-back h4{color:#4b5573;}"
			
			    // ---- 8. Destaque ao passar o mouse nos cards (escurece linhas que não compõem o card)
			    & ".dre-report tbody tr{transition:opacity .25s ease;}"
			    & ".dre-report.hl-rl tbody tr:not([data-card~='rl']),.dre-report.hl-lb tbody tr:not([data-card~='lb']),.dre-report.hl-ro tbody tr:not([data-card~='ro']),.dre-report.hl-rq tbody tr:not([data-card~='rq']){opacity:.25;}"
			    & ".dre-report.hl-rl tbody tr[data-card~='rl'] td,.dre-report.hl-lb tbody tr[data-card~='lb'] td,.dre-report.hl-ro tbody tr[data-card~='ro'] td,.dre-report.hl-rq tbody tr[data-card~='rq'] td{box-shadow:inset 0 0 0 9999px rgba(96,165,250,.10);}"
			    & ".dre-report tbody tr.is-target td{box-shadow:inset 0 0 0 9999px rgba(52,211,153,.16)!important;}"
			    & ".dre-report tbody tr.is-target td.cat{border-left:3px solid #34d399;}"
			
			    // ---- 9. Destaque no tema claro
			    & ".dre-report.light.hl-rl tbody tr[data-card~='rl'] td,.dre-report.light.hl-lb tbody tr[data-card~='lb'] td,.dre-report.light.hl-ro tbody tr[data-card~='ro'] td,.dre-report.light.hl-rq tbody tr[data-card~='rq'] td{box-shadow:inset 0 0 0 9999px rgba(37,99,235,.10);}"
			    & ".dre-report.light tbody tr.is-target td{box-shadow:inset 0 0 0 9999px rgba(5,150,105,.18)!important;}"
			
			    & "</style>"
		displayFolder: 00 HTML
		lineageTag: 50dd96eb-0734-45be-be00-c62e11c4e2ad

	/// Gera a linha HTML (12 meses + total) da DRE para: Receita Bruta de Vendas.
	measure 'HTML Linha - Receita Bruta de Vendas' =
			// =====================================================================
			// HTML Linha - Receita Bruta de Vendas
			// Monta a linha <tr> da DRE: 12 meses (Previsto x Realizado) + totais.
			//   Realizado = [Receita Bruta de Vendas] do mês no ano de referência (mês futuro = "-")
			//   Previsto  = [Receita Bruta de Vendas LY] (mesmo mês do ano anterior) x [Fator Previsão]
			// Valores exibidos em R$ mil.
			// =====================================================================
			VAR AnoRef = [Ano Referência DRE]
			VAR Sinal  = 1    // exibe com o sinal original
			
			// ---- 1. Tabela com os 12 meses e os valores Real / Previsto ----------
			VAR Meses =
			    ADDCOLUMNS(
			        SELECTCOLUMNS(GENERATESERIES(1, 12, 1), "Mes", [Value]),
			        "@Real",
			            VAR _Mes    = [Mes]
			            VAR _Futuro = AnoRef > YEAR(TODAY()) || (AnoRef = YEAR(TODAY()) && _Mes > MONTH(TODAY()))
			            RETURN
			                IF(
			                    _Futuro,
			                    BLANK(),
			                    Sinal * (CALCULATE([Receita Bruta de Vendas], REMOVEFILTERS(dCalendario), dCalendario[Ano] = AnoRef, dCalendario[NumMes] = _Mes) + 0)
			                ),
			        "@Prev",
			            VAR _Mes = [Mes]
			            RETURN
			                Sinal * (CALCULATE([Receita Bruta de Vendas LY], REMOVEFILTERS(dCalendario), dCalendario[Ano] = AnoRef, dCalendario[NumMes] = _Mes) + 0) * [Fator Previsão]
			    )
			
			// ---- 2. Totais ---------------------------------------------------------
			VAR TotalReal     = SUMX(Meses, [@Real])
			VAR TotalPrev     = SUMX(Meses, [@Prev])                                   // previsto do ano inteiro
			VAR TotalPrevComp = SUMX(FILTER(Meses, NOT ISBLANK([@Real])), [@Prev])    // previsto só dos meses já realizados (base da variação)
			VAR SobeTotal     = TotalReal >= TotalPrevComp
			
			// ---- 3. Células dos meses (<td class='mc'>) ------------------------
			//   <div class='prev'> = previsto | <div class='real'> = realizado + seta ▲/▼ e variação %
			VAR CelulasMeses =
			    CONCATENATEX(
			        Meses,
			        VAR _R    = [@Real]
			        VAR _P    = [@Prev]
			        VAR _Sobe = _R >= _P
			        RETURN
			            "<td class='mc'>"
			                & "<div class='prev'>" & FORMAT(DIVIDE(_P, 1000), "#,##0;-#,##0") & "</div>"
			                & "<div class='real'>"
			                    & IF(
			                        ISBLANK(_R),
			                        "-",
			                        FORMAT(DIVIDE(_R, 1000), "#,##0;-#,##0")
			                            & " <span class='delta " & IF(_Sobe, "up", "down") & "'>"
			                            & IF(_Sobe, UNICHAR(9650), UNICHAR(9660))
			                            & FORMAT(ABS(DIVIDE(_R - _P, ABS(_P), 0)), "0%")
			                            & "</span>"
			                    )
			                & "</div>"
			            & "</td>",
			        "",
			        [Mes], ASC
			    )
			
			// ---- 4. HTML final da linha -------------------------------------------
			//   id        = identificador da linha
			//   data-card = cards que destacam esta linha no hover (rl, lb, ro, rq)
			//   class     = estilo da linha (row-start, row-line, row-subtotal, row-total)
			RETURN
			    "<tr id='row-receita-bruta' data-card='rl lb ro rq' class='row-start'>"
			        & "<td class='cat'>Receita Bruta de Vendas</td>"
			        & CelulasMeses
			        & "<td class='total'>" & FORMAT(DIVIDE(TotalReal, 1000), "#,##0;-#,##0") & "</td>"
			        & "<td class='total prevtotal'>" & FORMAT(DIVIDE(TotalPrev, 1000), "#,##0;-#,##0") & "</td>"
			        & "<td class='total deltatotal " & IF(SobeTotal, "up", "down") & "'>"
			            & IF(SobeTotal, UNICHAR(9650), UNICHAR(9660))
			            & FORMAT(ABS(DIVIDE(TotalReal - TotalPrevComp, ABS(TotalPrevComp), 0)), "0%")
			        & "</td>"
			    & "</tr>"
		displayFolder: 00 HTML\Linhas
		lineageTag: ec6dd7c0-7d40-4e6f-934e-615058fafec5

	/// Gera a linha HTML (12 meses + total) da DRE para: (-) Deduções da Receita Bruta.
	measure 'HTML Linha - (-) Deduções da Receita Bruta' =
			// =====================================================================
			// HTML Linha - (-) Deduções da Receita Bruta
			// Monta a linha <tr> da DRE: 12 meses (Previsto x Realizado) + totais.
			//   Realizado = [Deduções da Receita Bruta] do mês no ano de referência (mês futuro = "-")
			//   Previsto  = [Deduções da Receita Bruta LY] (mesmo mês do ano anterior) x [Fator Previsão]
			// Valores exibidos em R$ mil.
			// =====================================================================
			VAR AnoRef = [Ano Referência DRE]
			VAR Sinal  = -1   // custo/dedução: inverte o sinal para exibir positivo na tabela
			
			// ---- 1. Tabela com os 12 meses e os valores Real / Previsto ----------
			VAR Meses =
			    ADDCOLUMNS(
			        SELECTCOLUMNS(GENERATESERIES(1, 12, 1), "Mes", [Value]),
			        "@Real",
			            VAR _Mes    = [Mes]
			            VAR _Futuro = AnoRef > YEAR(TODAY()) || (AnoRef = YEAR(TODAY()) && _Mes > MONTH(TODAY()))
			            RETURN
			                IF(
			                    _Futuro,
			                    BLANK(),
			                    Sinal * (CALCULATE([Deduções da Receita Bruta], REMOVEFILTERS(dCalendario), dCalendario[Ano] = AnoRef, dCalendario[NumMes] = _Mes) + 0)
			                ),
			        "@Prev",
			            VAR _Mes = [Mes]
			            RETURN
			                Sinal * (CALCULATE([Deduções da Receita Bruta LY], REMOVEFILTERS(dCalendario), dCalendario[Ano] = AnoRef, dCalendario[NumMes] = _Mes) + 0) * [Fator Previsão]
			    )
			
			// ---- 2. Totais ---------------------------------------------------------
			VAR TotalReal     = SUMX(Meses, [@Real])
			VAR TotalPrev     = SUMX(Meses, [@Prev])                                   // previsto do ano inteiro
			VAR TotalPrevComp = SUMX(FILTER(Meses, NOT ISBLANK([@Real])), [@Prev])    // previsto só dos meses já realizados (base da variação)
			VAR SobeTotal     = TotalReal >= TotalPrevComp
			
			// ---- 3. Células dos meses (<td class='mc'>) ------------------------
			//   <div class='prev'> = previsto | <div class='real'> = realizado + seta ▲/▼ e variação %
			VAR CelulasMeses =
			    CONCATENATEX(
			        Meses,
			        VAR _R    = [@Real]
			        VAR _P    = [@Prev]
			        VAR _Sobe = _R >= _P
			        RETURN
			            "<td class='mc'>"
			                & "<div class='prev'>" & FORMAT(DIVIDE(_P, 1000), "#,##0;-#,##0") & "</div>"
			                & "<div class='real'>"
			                    & IF(
			                        ISBLANK(_R),
			                        "-",
			                        FORMAT(DIVIDE(_R, 1000), "#,##0;-#,##0")
			                            & " <span class='delta " & IF(_Sobe, "up", "down") & "'>"
			                            & IF(_Sobe, UNICHAR(9650), UNICHAR(9660))
			                            & FORMAT(ABS(DIVIDE(_R - _P, ABS(_P), 0)), "0%")
			                            & "</span>"
			                    )
			                & "</div>"
