	/// Array JavaScript com Real e Previsto de cada mês (usado pelo seletor de mês dos cards).
	measure 'HTML JS Dados Mensais' =
			// =====================================================================
			// HTML JS Dados Mensais
			// Gera o array JavaScript com os números de cada mês, usado pelo
			// seletor de mês para trocar os valores dos cards. Formato:
			//   [{n:'Jan', rl:475800, rlp:430490, lb:..., lbp:...}, ...]
			// Para cada chave: valor Realizado e "<chave>p" = Previsto.
			// Mês futuro sem realizado sai como null.
			// Chaves: rl Receita Líquida | lb Lucro Bruto | ro Resultado Operacional
			//         rq Resultado Líquido | rb Receita Bruta | ded Deduções | cmv CMV
			//         gv Gastos Variáveis | gf Gastos Fixos | rf Resultado Financeiro
			//         inv Investimentos | imp Impostos
			// Sinal -1 = custos/deduções exibidos como valor positivo.
			// =====================================================================
			VAR AnoRef = [Ano Referência DRE]
			VAR Metricas =
			    DATATABLE(
			        "Chave", STRING,
			        "Sinal", INTEGER,
			        { {"rl", 1}, {"lb", 1}, {"ro", 1}, {"rq", 1}, {"rb", 1}, {"ded", -1}, {"cmv", -1}, {"gv", -1}, {"gf", -1}, {"rf", 1}, {"inv", -1}, {"imp", -1} }
			    )
			RETURN
			    "["
			    & CONCATENATEX(
			        SELECTCOLUMNS(GENERATESERIES(1, 12, 1), "Mes", [Value]),
			        VAR _Mes    = [Mes]
			        VAR _Futuro = AnoRef > YEAR(TODAY()) || (AnoRef = YEAR(TODAY()) && _Mes > MONTH(TODAY()))
			        RETURN
			            "{n:'" & MID("JanFevMarAbrMaiJunJulAgoSetOutNovDez", (_Mes - 1) * 3 + 1, 3) & "'"
			            & CONCATENATEX(
			                Metricas,
			                VAR _Chave = [Chave]
			                VAR _Sinal = [Sinal]
			                VAR _Real =
			                    CALCULATE(
			                        SWITCH(_Chave,
			                    "rl", [Receita Líquida],
			                    "lb", [Lucro Bruto],
			                    "ro", [Resultado Operacional],
			                    "rq", [Resultado Líquido],
			                    "rb", [Receita Bruta de Vendas],
			                    "ded", [Deduções da Receita Bruta],
			                    "cmv", [Custo das Mercadorias Vendidas],
			                    "gv", [Gastos Variáveis com Vendas],
			                    "gf", [Gastos Fixos],
			                    "rf", [Resultado Financeiro],
			                    "inv", [Investimentos],
			                    "imp", [Impostos sobre o Lucro]),
			                        REMOVEFILTERS(dCalendario), dCalendario[Ano] = AnoRef, dCalendario[NumMes] = _Mes
			                    )
			                VAR _Prev =
			                    CALCULATE(
			                        SWITCH(_Chave,
			                    "rl", [Receita Líquida LY],
			                    "lb", [Lucro Bruto LY],
			                    "ro", [Resultado Operacional LY],
			                    "rq", [Resultado Líquido LY],
			                    "rb", [Receita Bruta de Vendas LY],
			                    "ded", [Deduções da Receita Bruta LY],
			                    "cmv", [CMV LY],
			                    "gv", [Gastos Variáveis LY],
			                    "gf", [Gastos Fixos LY],
			                    "rf", [Resultado Financeiro LY],
			                    "inv", [Investimentos LY],
			                    "imp", [Impostos sobre o Lucro LY]),
			                        REMOVEFILTERS(dCalendario), dCalendario[Ano] = AnoRef, dCalendario[NumMes] = _Mes
			                    ) * [Fator Previsão]
			                RETURN
			                    "," & _Chave & ":" & IF(_Futuro, "null", FORMAT(_Sinal * (_Real + 0), "0"))
			                    & "," & _Chave & "p:" & FORMAT(_Sinal * (_Prev + 0), "0"),
			                ""
			            )
			            & "}",
			        ",",
			        [Mes], ASC
			    )
			    & "]"
		displayFolder: 00 HTML\JS
		lineageTag: 022f5b2c-8abb-4ac0-9630-ee3f1972caa6

	/// Código JavaScript do seletor de mês (atributo onchange do <select>).
	measure 'HTML JS Filtro Mês' =
			// =====================================================================
			// HTML JS Filtro Mês
			// JavaScript do seletor de mês (<select> no topo do relatório).
			//   - Ao escolher um mês: troca frente e verso dos 4 cards pelos números
			//     daquele mês (Realizado x Previsto) e recalcula cor/largura da barra.
			//   - "Ano inteiro" (value=''): restaura os valores originais dos cards.
			// Os números vêm de [HTML JS Dados Mensais].
			// O código entra no atributo onchange="..." do <select>, então usa só
			// aspas simples. Cada linha abaixo é um trecho do script.
			// =====================================================================
			"(function(v){"
			
			    // Atalho para document.getElementById
			    & "function g(id){return document.getElementById(id);}"
			
			    // Prefixo de cada card: rl Receita Líquida | lb Lucro Bruto | ro Resultado Operacional | rq Resultado Líquido
			    & "var ids=['rl','lb','ro','rq'];"
			    // Elementos de texto do card que podem mudar (valor, margem, comparação, verso)
			    & "var txtSuf=['vnum','vmar','cleft','cright','b1','b2','b3','b4','b5','bh4'];"
			
			    // ---- 1. Na 1ª vez, guarda os valores originais (ano inteiro) em data-orig
			    & "ids.forEach(function(k){"
			        & "txtSuf.forEach(function(s){var el=g(k+'-'+s);if(el&&el.dataset.orig===undefined){el.dataset.orig=el.innerHTML;}});"
			        & "var f=g(k+'-fill');if(f&&f.dataset.origClass===undefined){f.dataset.origClass=f.className;f.dataset.origWidth=f.style.width;}"
			    & "});"
			
			    // ---- 2. 'Ano inteiro' selecionado: restaura os originais e encerra
			    & "if(v===''){"
			        & "ids.forEach(function(k){"
			            & "txtSuf.forEach(function(s){var el=g(k+'-'+s);if(el&&el.dataset.orig!==undefined){el.innerHTML=el.dataset.orig;}});"
			            & "var f=g(k+'-fill');if(f&&f.dataset.origClass!==undefined){f.className=f.dataset.origClass;f.style.width=f.dataset.origWidth;}"
			        & "});"
			        & "return;"
			    & "}"
			
			    // ---- 3. Dados dos 12 meses (gerados no DAX)
			    & "var M=" & [HTML JS Dados Mensais] & ";"
			
			    // ---- 4. Funções auxiliares
			    // fmt: número -> 'R$ 476mil' / 'R$ 1,2mi' ; null -> '-'
			    & "function fmt(x){if(x===null||x===undefined)return '-';var neg=x<0,a=Math.abs(x),s;"
			        & "if(a>=1000000){s='R$ '+(a/1000000).toFixed(1).replace('.',',')+'mi';}else{s='R$ '+Math.round(a/1000)+'mil';}"
			        & "return neg?'-'+s:s;}"
			    // pct: 0.123 -> '12,3%' ; inválido -> '-'
			    & "function pct(x){if(x===null||!isFinite(x))return '-';return (x*100).toFixed(1).replace('.',',')+'%';}"
			    // setFill: cor e largura da barra = realizado / previsto (verde >=100%, amarelo >=90%, vermelho abaixo)
			    & "function setFill(k,r,p){var f=g(k+'-fill');if(!f)return;var ratio=(p&&r!==null)?Math.min(1,Math.max(0,r/p)):0;"
			        & "var cls=ratio>=1?'attention':(ratio>=0.9?'alert':'management');f.className='fill '+cls;f.style.width=Math.round(ratio*100)+'%';}"
			    // ttl: título do verso com o mês
			    & "function ttl(k,n){g(k+'-bh4').innerHTML='Como chegamos nesse valor — '+n;}"
			
			    // ---- 5. Mês escolhido (0 = Jan ... 11 = Dez)
			    & "var d=M[+v];"
			
			    // Card Receita Líquida (rl)
			    & "g('rl-vnum').innerHTML=fmt(d.rl);g('rl-cleft').innerHTML=d.n;"
			    & "g('rl-cright').innerHTML='Previsto <b>'+fmt(d.rlp)+'</b>';setFill('rl',d.rl,d.rlp);"
			    & "g('rl-b1').innerHTML=fmt(d.rb);g('rl-b2').innerHTML=fmt(d.ded);g('rl-b3').innerHTML=fmt(d.rl);ttl('rl',d.n);"
			
			    // Card Lucro Bruto (lb)
			    & "g('lb-vnum').innerHTML=fmt(d.lb);if(g('lb-vmar'))g('lb-vmar').innerHTML='('+pct(d.lb/d.rl)+')';g('lb-cleft').innerHTML=d.n;"
			    & "g('lb-cright').innerHTML='Previsto <b>'+fmt(d.lbp)+' ('+pct(d.lbp/d.rlp)+')</b>';setFill('lb',d.lb,d.lbp);"
			    & "g('lb-b1').innerHTML=fmt(d.rl);g('lb-b2').innerHTML=fmt(d.cmv);g('lb-b3').innerHTML=fmt(d.lb);ttl('lb',d.n);"
			
			    // Card Resultado Operacional (ro)
			    & "g('ro-vnum').innerHTML=fmt(d.ro);if(g('ro-vmar'))g('ro-vmar').innerHTML='('+pct(d.ro/d.rl)+')';g('ro-cleft').innerHTML=d.n;"
			    & "g('ro-cright').innerHTML='Previsto <b>'+fmt(d.rop)+' ('+pct(d.rop/d.rlp)+')</b>';setFill('ro',d.ro,d.rop);"
			    & "g('ro-b1').innerHTML=fmt(d.lb);g('ro-b2').innerHTML=fmt(d.gv);g('ro-b3').innerHTML=fmt(d.gf);g('ro-b4').innerHTML=fmt(d.ro);ttl('ro',d.n);"
			
			    // Card Resultado Líquido (rq)
			    & "g('rq-vnum').innerHTML=fmt(d.rq);if(g('rq-vmar'))g('rq-vmar').innerHTML='('+pct(d.rq/d.rl)+')';g('rq-cleft').innerHTML=d.n;"
			    & "g('rq-cright').innerHTML='Previsto <b>'+fmt(d.rqp)+' ('+pct(d.rqp/d.rlp)+')</b>';setFill('rq',d.rq,d.rqp);"
			    & "g('rq-b1').innerHTML=fmt(d.ro);g('rq-b2').innerHTML=fmt(d.rf);g('rq-b3').innerHTML=fmt(d.inv);g('rq-b4').innerHTML=fmt(d.imp);g('rq-b5').innerHTML=fmt(d.rq);ttl('rq',d.n);"
			
			& "})(this.value)"
		displayFolder: 00 HTML\JS
		lineageTag: 6e2a82f5-9a6f-4546-9188-e435357929e2

	column 'Coluna 1'
