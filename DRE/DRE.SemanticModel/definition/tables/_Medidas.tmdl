			                IF(
			                    _Futuro,
			                    BLANK(),
			                    Sinal * (CALCULATE([Resultado Operacional], REMOVEFILTERS(dCalendario), dCalendario[Ano] = AnoRef, dCalendario[NumMes] = _Mes) + 0)
