			RETURN
			    "<tr id='row-resultado-liquido' data-card='rq' class='row-total is-target'>"
			        & "<td class='cat'>(=) Resultado Líquido do Exercício</td>"
			        & CelulasMeses
			        & "<td class='total'>" & FORMAT(DIVIDE(TotalReal, 1000), "#,##0;-#,##0") & "</td>"
			        & "<td class='total prevtotal'>" & FORMAT(DIVIDE(TotalPrev, 1000), "#,##0;-#,##0") & "</td>"
			        & "<td class='total deltatotal " & IF(SobeTotal, "up", "down") & "'>"
			            & IF(SobeTotal, UNICHAR(9650), UNICHAR(9660))
			            & FORMAT(ABS(DIVIDE(TotalReal - TotalPrevComp, ABS(TotalPrevComp), 0)), "0%")
			        & "</td>"
			    & "</tr>"
		displayFolder: 00 HTML\Linhas
		lineageTag: 55c5b76b-9f88-4007-869a-253680f3a520

	/// Card HTML dinâmico: Receita Líquida do ano vs ano anterior.
	measure 'HTML Card - Receita Líquida' =
			// =====================================================================
			// HTML Card - Receita Líquida
			// Card de KPI com efeito flip:
			//   Frente = valor do ano (Real + Previsão) e comparação com o ano anterior
			//   Verso  = "Como chegamos nesse valor" (composição do resultado)
			// Prefixo dos ids: 'rl' (usado pelo JS do seletor de mês e pelo destaque das linhas)
			// =====================================================================
			VAR AnoRef = [Ano Referência DRE]
			
			// ---- 1. Valores ---------------------------------------------------------
			VAR ValAtual = CALCULATE([Receita Líquida (Real + Previsão)], REMOVEFILTERS(dCalendario), dCalendario[Ano] = AnoRef)
			VAR ValLY    = CALCULATE([Receita Líquida (Real + Previsão)], REMOVEFILTERS(dCalendario), dCalendario[Ano] = AnoRef - 1)
			
			VAR ReceitaBruta = CALCULATE([Receita Bruta de Vendas (Real + Previsão)], REMOVEFILTERS(dCalendario), dCalendario[Ano] = AnoRef)
			VAR Deducoes = ReceitaBruta - ValAtual
			
			// ---- 2. Cor da barra: >= 100% do ano anterior = verde | >= 90% = amarelo | abaixo = vermelho
			VAR Ratio = DIVIDE(ValAtual, ValLY)
			VAR Cls   = IF(Ratio >= 1, "attention", IF(Ratio >= 0.9, "alert", "management"))
			
			// ---- 3. Textos formatados (R$ mi a partir de 50.000.000) ---------------
			VAR FmtValor = IF(ABS(ValAtual) >= 50000000, FORMAT(ValAtual, "R$ #,##0.0,,""mi"""), FORMAT(ValAtual, "R$ #,##0,""mil"""))
			VAR FmtValorLY = IF(ABS(ValLY) >= 50000000, FORMAT(ValLY, "R$ #,##0.0,,""mi"""), FORMAT(ValLY, "R$ #,##0,""mil"""))
			VAR FmtReceitaBruta = IF(ABS(ReceitaBruta) >= 50000000, FORMAT(ReceitaBruta, "R$ #,##0.0,,""mi"""), FORMAT(ReceitaBruta, "R$ #,##0,""mil"""))
			VAR FmtDeducoes = IF(ABS(Deducoes) >= 50000000, FORMAT(Deducoes, "R$ #,##0.0,,""mi"""), FORMAT(Deducoes, "R$ #,##0,""mil"""))
			
			// ---- 4. HTML do card -------------------------------------------------------
			RETURN
			    // Container: no hover adiciona a classe hl-rl no relatório (destaca as linhas da tabela)
			    "<div class='card' id='card-rl'"
			        & " onmouseenter=""document.getElementById('dre-container').classList.add('hl-rl')"""
			        & " onmouseleave=""document.getElementById('dre-container').classList.remove('hl-rl')"">"
			        & "<div class='card-inner'>"
			
			            // Frente
			            & "<div class='card-face card-front'>"
			                & "<h3 id='rl-h3'>Receita Líquida</h3>"
			                & "<div class='value'><span id='rl-vnum'>" & FmtValor & "</span>" & "</div>"
			                & "<div class='compare'>"
			                    & "<span id='rl-cleft'>" & FORMAT(AnoRef, "0") & "</span>"
			                    & "<span id='rl-cright'>" & FORMAT(AnoRef - 1, "0") & " <b>" & FmtValorLY & "</b></span>"
			                & "</div>"
			                & "<div class='track'><div class='fill " & Cls & "' id='rl-fill' style='width:" & FORMAT(MIN(1, MAX(0, Ratio)), "0%") & "'></div></div>"
			            & "</div>"
			
			            // Verso
			            & "<div class='card-face card-back'>"
			                & "<h4 id='rl-bh4'>Como chegamos nesse valor</h4>"
			                & "<div class='bline'><span>Receita Bruta de Vendas</span><b id='rl-b1'>" & FmtReceitaBruta & "</b></div>"
			                & "<div class='bline'><span>(-) Deduções</span><b id='rl-b2'>" & FmtDeducoes & "</b></div>"
			                & "<div class='bline result'><span>(=) Receita Líquida</span><b id='rl-b3'>" & FmtValor & "</b></div>"
			            & "</div>"
			
			        & "</div>"
			    & "</div>"
		displayFolder: 00 HTML\Cards
		lineageTag: 28d085a8-1ed2-4568-b988-9bf9cadb9e8f

	/// Card HTML dinâmico: Lucro Bruto e margem do ano vs ano anterior.
	measure 'HTML Card - Lucro Bruto' =
			// =====================================================================
			// HTML Card - Lucro Bruto
			// Card de KPI com efeito flip:
			//   Frente = valor do ano (Real + Previsão), margem e comparação com o ano anterior
			//   Verso  = "Como chegamos nesse valor" (composição do resultado)
			// Prefixo dos ids: 'lb' (usado pelo JS do seletor de mês e pelo destaque das linhas)
			// =====================================================================
			VAR AnoRef = [Ano Referência DRE]
			
			// ---- 1. Valores ---------------------------------------------------------
			VAR ValAtual = CALCULATE([Lucro Bruto (Real + Previsão)], REMOVEFILTERS(dCalendario), dCalendario[Ano] = AnoRef)
			VAR ValLY    = CALCULATE([Lucro Bruto (Real + Previsão)], REMOVEFILTERS(dCalendario), dCalendario[Ano] = AnoRef - 1)
			VAR MargemAtual = CALCULATE([Margem Bruta %], REMOVEFILTERS(dCalendario), dCalendario[Ano] = AnoRef)
			VAR MargemLY    = CALCULATE([Margem Bruta %], REMOVEFILTERS(dCalendario), dCalendario[Ano] = AnoRef - 1)
			VAR ReceitaLiquida = CALCULATE([Receita Líquida (Real + Previsão)], REMOVEFILTERS(dCalendario), dCalendario[Ano] = AnoRef)
			VAR CMV = ReceitaLiquida - ValAtual
			
			// ---- 2. Cor da barra: >= 100% do ano anterior = verde | >= 90% = amarelo | abaixo = vermelho
			VAR Ratio = DIVIDE(ValAtual, ValLY)
			VAR Cls   = IF(Ratio >= 1, "attention", IF(Ratio >= 0.9, "alert", "management"))
			
			// ---- 3. Textos formatados (R$ mi a partir de 50.000.000) ---------------
			VAR FmtValor = IF(ABS(ValAtual) >= 50000000, FORMAT(ValAtual, "R$ #,##0.0,,""mi"""), FORMAT(ValAtual, "R$ #,##0,""mil"""))
			VAR FmtValorLY = IF(ABS(ValLY) >= 50000000, FORMAT(ValLY, "R$ #,##0.0,,""mi"""), FORMAT(ValLY, "R$ #,##0,""mil"""))
			VAR FmtReceitaLiquida = IF(ABS(ReceitaLiquida) >= 50000000, FORMAT(ReceitaLiquida, "R$ #,##0.0,,""mi"""), FORMAT(ReceitaLiquida, "R$ #,##0,""mil"""))
			VAR FmtCMV = IF(ABS(CMV) >= 50000000, FORMAT(CMV, "R$ #,##0.0,,""mi"""), FORMAT(CMV, "R$ #,##0,""mil"""))
			
			// ---- 4. HTML do card -------------------------------------------------------
			RETURN
			    // Container: no hover adiciona a classe hl-lb no relatório (destaca as linhas da tabela)
			    "<div class='card' id='card-lb'"
			        & " onmouseenter=""document.getElementById('dre-container').classList.add('hl-lb')"""
			        & " onmouseleave=""document.getElementById('dre-container').classList.remove('hl-lb')"">"
			        & "<div class='card-inner'>"
			
			            // Frente
			            & "<div class='card-face card-front'>"
			                & "<h3 id='lb-h3'>Lucro Bruto</h3>"
			                & "<div class='value'><span id='lb-vnum'>" & FmtValor & "</span>" & " <span id='lb-vmar' style='font-size:12px;color:#8a94b3'>(" & FORMAT(MargemAtual, "0.0%") & ")</span>" & "</div>"
			                & "<div class='compare'>"
			                    & "<span id='lb-cleft'>" & FORMAT(AnoRef, "0") & "</span>"
			                    & "<span id='lb-cright'>" & FORMAT(AnoRef - 1, "0") & " <b>" & FmtValorLY & " (" & FORMAT(MargemLY, "0.0%") & ")" & "</b></span>"
			                & "</div>"
			                & "<div class='track'><div class='fill " & Cls & "' id='lb-fill' style='width:" & FORMAT(MIN(1, MAX(0, Ratio)), "0%") & "'></div></div>"
			            & "</div>"
			
			            // Verso
			            & "<div class='card-face card-back'>"
			                & "<h4 id='lb-bh4'>Como chegamos nesse valor</h4>"
			                & "<div class='bline'><span>Receita Líquida</span><b id='lb-b1'>" & FmtReceitaLiquida & "</b></div>"
			                & "<div class='bline'><span>(-) CMV</span><b id='lb-b2'>" & FmtCMV & "</b></div>"
			                & "<div class='bline result'><span>(=) Lucro Bruto</span><b id='lb-b3'>" & FmtValor & "</b></div>"
			            & "</div>"
			
			        & "</div>"
			    & "</div>"
		displayFolder: 00 HTML\Cards
		lineageTag: de9759fb-ec3f-473a-8828-68b55046e668

	/// Card HTML dinâmico: Resultado Operacional e margem do ano vs ano anterior.
	measure 'HTML Card - Resultado Operacional' =
			// =====================================================================
			// HTML Card - Resultado Operacional
			// Card de KPI com efeito flip:
			//   Frente = valor do ano (Real + Previsão), margem e comparação com o ano anterior
			//   Verso  = "Como chegamos nesse valor" (composição do resultado)
			// Prefixo dos ids: 'ro' (usado pelo JS do seletor de mês e pelo destaque das linhas)
			// =====================================================================
			VAR AnoRef = [Ano Referência DRE]
			
			// ---- 1. Valores ---------------------------------------------------------
			VAR ValAtual = CALCULATE([Resultado Operacional (Real + Previsão)], REMOVEFILTERS(dCalendario), dCalendario[Ano] = AnoRef)
			VAR ValLY    = CALCULATE([Resultado Operacional (Real + Previsão)], REMOVEFILTERS(dCalendario), dCalendario[Ano] = AnoRef - 1)
			VAR MargemAtual = CALCULATE([Margem Operacional %], REMOVEFILTERS(dCalendario), dCalendario[Ano] = AnoRef)
			VAR MargemLY    = CALCULATE([Margem Operacional %], REMOVEFILTERS(dCalendario), dCalendario[Ano] = AnoRef - 1)
			VAR LucroBruto = CALCULATE([Lucro Bruto (Real + Previsão)], REMOVEFILTERS(dCalendario), dCalendario[Ano] = AnoRef)
			VAR GastosVariaveis = -CALCULATE([Gastos Variáveis (Real + Previsão)], REMOVEFILTERS(dCalendario), dCalendario[Ano] = AnoRef)
			VAR GastosFixos = -CALCULATE([Gastos Fixos (Real + Previsão)], REMOVEFILTERS(dCalendario), dCalendario[Ano] = AnoRef)
			
			// ---- 2. Cor da barra: >= 100% do ano anterior = verde | >= 90% = amarelo | abaixo = vermelho
			VAR Ratio = DIVIDE(ValAtual, ValLY)
			VAR Cls   = IF(Ratio >= 1, "attention", IF(Ratio >= 0.9, "alert", "management"))
			
			// ---- 3. Textos formatados (R$ mi a partir de 50.000.000) ---------------
			VAR FmtValor = IF(ABS(ValAtual) >= 50000000, FORMAT(ValAtual, "R$ #,##0.0,,""mi"""), FORMAT(ValAtual, "R$ #,##0,""mil"""))
			VAR FmtValorLY = IF(ABS(ValLY) >= 50000000, FORMAT(ValLY, "R$ #,##0.0,,""mi"""), FORMAT(ValLY, "R$ #,##0,""mil"""))
			VAR FmtLucroBruto = IF(ABS(LucroBruto) >= 50000000, FORMAT(LucroBruto, "R$ #,##0.0,,""mi"""), FORMAT(LucroBruto, "R$ #,##0,""mil"""))
			VAR FmtGastosVariaveis = IF(ABS(GastosVariaveis) >= 50000000, FORMAT(GastosVariaveis, "R$ #,##0.0,,""mi"""), FORMAT(GastosVariaveis, "R$ #,##0,""mil"""))
			VAR FmtGastosFixos = IF(ABS(GastosFixos) >= 50000000, FORMAT(GastosFixos, "R$ #,##0.0,,""mi"""), FORMAT(GastosFixos, "R$ #,##0,""mil"""))
			
			// ---- 4. HTML do card -------------------------------------------------------
			RETURN
			    // Container: no hover adiciona a classe hl-ro no relatório (destaca as linhas da tabela)
			    "<div class='card' id='card-ro'"
			        & " onmouseenter=""document.getElementById('dre-container').classList.add('hl-ro')"""
			        & " onmouseleave=""document.getElementById('dre-container').classList.remove('hl-ro')"">"
			        & "<div class='card-inner'>"
			
			            // Frente
			            & "<div class='card-face card-front'>"
			                & "<h3 id='ro-h3'>Resultado Operacional</h3>"
			                & "<div class='value'><span id='ro-vnum'>" & FmtValor & "</span>" & " <span id='ro-vmar' style='font-size:12px;color:#8a94b3'>(" & FORMAT(MargemAtual, "0.0%") & ")</span>" & "</div>"
			                & "<div class='compare'>"
			                    & "<span id='ro-cleft'>" & FORMAT(AnoRef, "0") & "</span>"
			                    & "<span id='ro-cright'>" & FORMAT(AnoRef - 1, "0") & " <b>" & FmtValorLY & " (" & FORMAT(MargemLY, "0.0%") & ")" & "</b></span>"
			                & "</div>"
			                & "<div class='track'><div class='fill " & Cls & "' id='ro-fill' style='width:" & FORMAT(MIN(1, MAX(0, Ratio)), "0%") & "'></div></div>"
			            & "</div>"
			
			            // Verso
			            & "<div class='card-face card-back'>"
			                & "<h4 id='ro-bh4'>Como chegamos nesse valor</h4>"
			                & "<div class='bline'><span>Lucro Bruto</span><b id='ro-b1'>" & FmtLucroBruto & "</b></div>"
			                & "<div class='bline'><span>(-) Gastos Variáveis com Vendas</span><b id='ro-b2'>" & FmtGastosVariaveis & "</b></div>"
			                & "<div class='bline'><span>(-) Gastos Fixos</span><b id='ro-b3'>" & FmtGastosFixos & "</b></div>"
			                & "<div class='bline result'><span>(=) Resultado Operacional</span><b id='ro-b4'>" & FmtValor & "</b></div>"
			            & "</div>"
			
			        & "</div>"
			    & "</div>"
		displayFolder: 00 HTML\Cards
		lineageTag: 95fe8ba2-26bc-4568-8796-71f99db04661

	/// Card HTML dinâmico: Resultado Líquido e margem do ano vs ano anterior.
	measure 'HTML Card - Resultado Líquido' =
			// =====================================================================
			// HTML Card - Resultado Líquido
			// Card de KPI com efeito flip:
			//   Frente = valor do ano (Real + Previsão), margem e comparação com o ano anterior
			//   Verso  = "Como chegamos nesse valor" (composição do resultado)
			// Prefixo dos ids: 'rq' (usado pelo JS do seletor de mês e pelo destaque das linhas)
			// =====================================================================
			VAR AnoRef = [Ano Referência DRE]
			
			// ---- 1. Valores ---------------------------------------------------------
			VAR ValAtual = CALCULATE([Resultado Líquido (Real + Previsão)], REMOVEFILTERS(dCalendario), dCalendario[Ano] = AnoRef)
			VAR ValLY    = CALCULATE([Resultado Líquido (Real + Previsão)], REMOVEFILTERS(dCalendario), dCalendario[Ano] = AnoRef - 1)
			VAR MargemAtual = CALCULATE([Margem Líquida %], REMOVEFILTERS(dCalendario), dCalendario[Ano] = AnoRef)
			VAR MargemLY    = CALCULATE([Margem Líquida %], REMOVEFILTERS(dCalendario), dCalendario[Ano] = AnoRef - 1)
			VAR ResultadoOperacional = CALCULATE([Resultado Operacional (Real + Previsão)], REMOVEFILTERS(dCalendario), dCalendario[Ano] = AnoRef)
			VAR ResultadoFinanceiro = CALCULATE([Resultado Financeiro (Real + Previsão)], REMOVEFILTERS(dCalendario), dCalendario[Ano] = AnoRef)
			VAR Investimentos = -CALCULATE([Investimentos (Real + Previsão)], REMOVEFILTERS(dCalendario), dCalendario[Ano] = AnoRef)
			VAR Impostos = -CALCULATE([Impostos sobre o Lucro (Real + Previsão)], REMOVEFILTERS(dCalendario), dCalendario[Ano] = AnoRef)
			
			// ---- 2. Cor da barra: >= 100% do ano anterior = verde | >= 90% = amarelo | abaixo = vermelho
			VAR Ratio = DIVIDE(ValAtual, ValLY)
			VAR Cls   = IF(Ratio >= 1, "attention", IF(Ratio >= 0.9, "alert", "management"))
			
			// ---- 3. Textos formatados (R$ mi a partir de 1.000.000) ---------------
			VAR FmtValor = IF(ABS(ValAtual) >= 1000000, FORMAT(ValAtual, "R$ #,##0.0,,""mi"""), FORMAT(ValAtual, "R$ #,##0,""mil"""))
			VAR FmtValorLY = IF(ABS(ValLY) >= 1000000, FORMAT(ValLY, "R$ #,##0.0,,""mi"""), FORMAT(ValLY, "R$ #,##0,""mil"""))
			VAR FmtResultadoOperacional = IF(ABS(ResultadoOperacional) >= 1000000, FORMAT(ResultadoOperacional, "R$ #,##0.0,,""mi"""), FORMAT(ResultadoOperacional, "R$ #,##0,""mil"""))
			VAR FmtResultadoFinanceiro = IF(ABS(ResultadoFinanceiro) >= 1000000, FORMAT(ResultadoFinanceiro, "R$ #,##0.0,,""mi"""), FORMAT(ResultadoFinanceiro, "R$ #,##0,""mil"""))
			VAR FmtInvestimentos = IF(ABS(Investimentos) >= 1000000, FORMAT(Investimentos, "R$ #,##0.0,,""mi"""), FORMAT(Investimentos, "R$ #,##0,""mil"""))
			VAR FmtImpostos = IF(ABS(Impostos) >= 1000000, FORMAT(Impostos, "R$ #,##0.0,,""mi"""), FORMAT(Impostos, "R$ #,##0,""mil"""))
			
			// ---- 4. HTML do card -------------------------------------------------------
			RETURN
			    // Container: no hover adiciona a classe hl-rq no relatório (destaca as linhas da tabela)
			    "<div class='card' id='card-rq'"
			        & " onmouseenter=""document.getElementById('dre-container').classList.add('hl-rq')"""
			        & " onmouseleave=""document.getElementById('dre-container').classList.remove('hl-rq')"">"
			        & "<div class='card-inner'>"
			
			            // Frente
			            & "<div class='card-face card-front'>"
			                & "<h3 id='rq-h3'>Resultado Líquido</h3>"
			                & "<div class='value'><span id='rq-vnum'>" & FmtValor & "</span>" & " <span id='rq-vmar' style='font-size:12px;color:#8a94b3'>(" & FORMAT(MargemAtual, "0.0%") & ")</span>" & "</div>"
			                & "<div class='compare'>"
			                    & "<span id='rq-cleft'>" & FORMAT(AnoRef, "0") & "</span>"
			                    & "<span id='rq-cright'>" & FORMAT(AnoRef - 1, "0") & " <b>" & FmtValorLY & " (" & FORMAT(MargemLY, "0.0%") & ")" & "</b></span>"
			                & "</div>"
			                & "<div class='track'><div class='fill " & Cls & "' id='rq-fill' style='width:" & FORMAT(MIN(1, MAX(0, Ratio)), "0%") & "'></div></div>"
			            & "</div>"
			
			            // Verso
			            & "<div class='card-face card-back'>"
			                & "<h4 id='rq-bh4'>Como chegamos nesse valor</h4>"
			                & "<div class='bline'><span>Resultado Operacional</span><b id='rq-b1'>" & FmtResultadoOperacional & "</b></div>"
			                & "<div class='bline'><span>(+/-) Resultado Financeiro</span><b id='rq-b2'>" & FmtResultadoFinanceiro & "</b></div>"
			                & "<div class='bline'><span>(-) Investimentos</span><b id='rq-b3'>" & FmtInvestimentos & "</b></div>"
			                & "<div class='bline'><span>(-) Impostos sobre o Lucro</span><b id='rq-b4'>" & FmtImpostos & "</b></div>"
			                & "<div class='bline result'><span>(=) Resultado Líquido</span><b id='rq-b5'>" & FmtValor & "</b></div>"
			            & "</div>"
			
			        & "</div>"
			    & "</div>"
		displayFolder: 00 HTML\Cards
		lineageTag: 72d0842e-99d9-49ff-a50c-e1f9d8688607

	/// Medida final: monta o relatório HTML completo da DRE (CSS + cabeçalho + cards + tabela mensal + rodapé). Conecte esta medida ao visual HTML Content do Power BI.
	measure 'HTML DRE' =
			// =====================================================================
			// HTML DRE  (medida final — usar no visual HTML Content)
			// Estrutura do relatório:
			//   1. CSS ................. [HTML CSS Base]
			//   2. Barra de ferramentas: seletor de mês + botão de tema claro/escuro
			//   3. Cabeçalho: título, ano de referência, data de atualização, legenda
			//   4. Cards de KPI ........ [HTML Card - ...]
			//   5. Tabela mensal ....... [HTML Linha - ...] (uma medida por linha da DRE)
			// =====================================================================
			VAR AnoRef = [Ano Referência DRE]
			
			// ---- Cabeçalho da tabela: "Jan ... Dez", cada um com sub-rótulo Prev | Real
			VAR CabecalhoMeses =
			    CONCATENATEX(
			        SELECTCOLUMNS(GENERATESERIES(1, 12, 1), "Mes", [Value]),
			        "<th>" & MID("JanFevMarAbrMaiJunJulAgoSetOutNovDez", ([Mes] - 1) * 3 + 1, 3)
			            & "<div class='monthsub'><span class='sp'>Prev</span><span class='sr'>Real</span></div></th>",
			        "",
			        [Mes], ASC
			    )
			
			// ---- Opções do seletor de mês (value = índice 0..11 usado pelo JS)
			VAR OpcoesMes =
			    "<option value=''>📅 Ano inteiro</option>"
			    & "<option value='0'>Janeiro</option>"
			    & "<option value='1'>Fevereiro</option>"
			    & "<option value='2'>Março</option>"
			    & "<option value='3'>Abril</option>"
			    & "<option value='4'>Maio</option>"
			    & "<option value='5'>Junho</option>"
			    & "<option value='6'>Julho</option>"
			    & "<option value='7'>Agosto</option>"
			    & "<option value='8'>Setembro</option>"
			    & "<option value='9'>Outubro</option>"
			    & "<option value='10'>Novembro</option>"
			    & "<option value='11'>Dezembro</option>"
			
			RETURN
			    // 1. CSS
			    [HTML CSS Base]
			
			    // Container principal (id usado pelo JS e pelos destaques dos cards)
			    & "<div class='dre-report' id='dre-container'>"
			
			        // 2. Barra de ferramentas
			        & "<div class='toolbar'>"
			            // Seletor de mês: o JS está em [HTML JS Filtro Mês]
			            & "<select class='theme-btn' style='cursor:pointer' onchange=""" & [HTML JS Filtro Mês] & """>"
			                & OpcoesMes
			            & "</select>"
			            // Botão de tema: liga/desliga a classe .light no container
			            & "<button class='theme-btn' onclick="""
			                & "document.getElementById('dre-container').classList.toggle('light');"
			                & "this.textContent=(document.getElementById('dre-container').classList.contains('light')?'🌙 Tema Escuro':'☀️ Tema Claro');"
			            & """>☀️ Tema Claro</button>"
			        & "</div>"
			
			        // 3. Cabeçalho
			        & "<div class='head'>"
			            & "<div class='brand'><div>"
			                & "<div class='title'>📊 DRE <b>Gerencial</b> — Consolidado</div>"
			                & "<div class='sub'>Demonstrativo do Resultado do Exercício &middot; Ano " & FORMAT(AnoRef, "0") & "</div>"
			            & "</div></div>"
			            & "<div class='meta'>Atualizado em " & FORMAT(TODAY(), "dd/mm/yyyy")
			                & "<div class='legend'>"
			                    & "<span class='chip attention'>No alvo</span>"
			                    & "<span class='chip alert'>Atenção</span>"
			                    & "<span class='chip management'>Abaixo</span>"
			                & "</div>"
			            & "</div>"
			        & "</div>"
			
			        // 4. Cards de KPI (grid de 4 colunas)
			        & "<div class='grid g4'>"
			            & [HTML Card - Receita Líquida]
			            & [HTML Card - Lucro Bruto]
			            & [HTML Card - Resultado Operacional]
			            & [HTML Card - Resultado Líquido]
			        & "</div>"
			        & "<div style='text-align:right;font-size:10.5px;color:#8a94b3;margin:-4px 0 10px;'>💡 Passe o mouse sobre um card acima para destacar, no quadro abaixo, as linhas que compõem aquele valor.</div>"
			
			        // 5. Tabela mensal da DRE
			        & "<div class='panel'>"
			            & "<div class='panel-title'>"
			                & "<h2>DRE Mensal " & FORMAT(AnoRef, "0") & " — valores em R$ mil</h2>"
			                & "<div class='hint'>Em cada mês: <span style='color:#c9974a'>Previsto</span> e <b>Realizado</b>, com a variação % ao lado · arraste a tabela para o lado para ver todos os meses</div>"
			            & "</div>"
			            & "<div class='table-scroll'><table>"
			                // Cabeçalho: Linha | Jan..Dez | Real | Previsto | Var
			                & "<thead><tr>"
			                    & "<th>Linha da DRE</th>"
			                    & CabecalhoMeses
			                    & "<th class='total-h'>Real</th><th class='total-h'>Previsto</th><th class='total-h'>Var</th>"
			                & "</tr></thead>"
			                // Corpo: uma medida por linha, na ordem da DRE
			                & "<tbody>"
			                    & [HTML Linha - Receita Bruta de Vendas]
			                    & [HTML Linha - (-) Deduções da Receita Bruta]
			                    & [HTML Linha - (=) Receita Líquida]
			                    & [HTML Linha - (-) Custo das Mercadorias Vendidas (CMV)]
			                    & [HTML Linha - (=) Lucro Bruto]
			                    & [HTML Linha - (-) Gastos Variáveis com Vendas]
			                    & [HTML Linha - (-) Gastos Fixos]
			                    & [HTML Linha - (=) Resultado Operacional]
			                    & [HTML Linha - (+/-) Resultado Financeiro]
			                    & [HTML Linha - (-) Investimentos]
			                    & [HTML Linha - (=) Resultado Antes do IR]
			                    & [HTML Linha - (-) Impostos sobre o Lucro]
			                    & [HTML Linha - (=) Resultado Líquido do Exercício]
			                & "</tbody>"
			            & "</table></div>"
			        & "</div>"
			
			    & "</div>"
		displayFolder: 00 HTML
		lineageTag: 1721b386-46f4-49e1-a394-d43595c3e39a

