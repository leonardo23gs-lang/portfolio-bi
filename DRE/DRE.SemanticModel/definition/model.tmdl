model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 1

annotation PBI_QueryOrder = ["CaminhoBaseDRE","_Medidas","fDRE"]

annotation PBI_ProTooling = ["MCP-PBIModeling","DevMode"]

ref table _Medidas
ref table dCalendario
ref table 'Parâmetro Ano DRE'
ref table fDRE

ref cultureInfo pt-BR

